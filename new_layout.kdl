Widget {
  constraint Fill=1
  block title="FOCUS"
  layout {
    T Text="${niri.app_id} | $[ul](${niri.title})"
    VGroup center=#false {
      elements Text="${niri.app_id}"
      elements Text="${niri.title}"
    }
  }
}

