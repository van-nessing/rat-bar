Widget {
  block title="VISUALIZER"
  constraint Length=27
  layout {
    Graph fg="Gray" fill=#true marker="Braille" var="visualizer.bins"
  }
}

Widget {
  block title="CLOCK"
  constraint Length=30
  layout {
    HGroup {
      // elements Text="${clock.day}"
      Bar bg="DarkGray" fg="Gray" direction="Vertical" var="pipewire.volume"
      Text "a"
      // elements Text="${clock.time}"
      // elements Text="${clock.date}"
      // Graph fg="Gray" fill=#true marker="Braille" var="visualizer.bins"
      // Bar fg
